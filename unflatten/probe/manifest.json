{
  "manifestVersion": 5,
  "id": "com.unflatten.probe",
  "name": "Unflatten Probe",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.1.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "probePanel",
      "label": { "default": "Unflatten Probe" },
      "minimumSize": { "width": 260, "height": 300 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 320, "height": 560 },
      "preferredFloatingSize": { "width": 360, "height": 620 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["http://127.0.0.1:7865", "http://localhost:7865"] }
  }
}
