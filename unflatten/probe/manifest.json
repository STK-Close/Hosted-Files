{
  "manifestVersion": 5,
  "id": "com.unflatten.probe",
  "name": "Unflatten Probe",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "probePanel",
      "label": {
        "default": "Unflatten Probe"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 640
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://images.unsplash.com"
      ]
    }
  }
}
