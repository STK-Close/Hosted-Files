{
  "manifestVersion": 5,
  "id": "com.unflatten.photoshop",
  "name": "Unflatten",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "unflattenPanel",
      "label": { "default": "Unflatten" },
      "minimumSize": { "width": 200, "height": 180 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 240, "height": 220 },
      "preferredFloatingSize": { "width": 260, "height": 240 }
    }
  ]
}
