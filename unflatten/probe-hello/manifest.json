{
  "manifestVersion": 5,
  "id": "com.unflatten.hello",
  "name": "Unflatten Hello",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "23.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "helloPanel",
      "label": { "default": "Unflatten Hello" },
      "minimumSize": { "width": 200, "height": 120 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 240, "height": 160 },
      "preferredFloatingSize": { "width": 260, "height": 180 }
    }
  ]
}
